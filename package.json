{
  "name": "clckd",
  "version": "0.1.0",
  "private": true,
  "description": "Local management application for videographers (foundation batch).",
  "engines": {
    "node": ">=20.19.2"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3300",
    "start": "next start -H 127.0.0.1 -p 3300",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
